{
  "name": "flask-jwt-auth-app-backend",
  "version": "1.0.0",
  "description": "Backend for the Flask JWT Auth App",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:dev": "nodemon server.js",
    "test": "NODE_ENV=test ./node_modules/.bin/jest --testTimeout=10000 --detectOpenHandles",
    "lint": "./node_modules/.bin/eslint . --ext .js",
    "lint:fix": "./node_modules/.bin/eslint . --ext .js --fix",
    "format": "./node_modules/.bin/prettier --write \"**/*.js\"",
    "db:seed": "node src/db/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.4.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.5.3",
    "supertest": "^7.1.1"
  },
  "keywords": [
    "express",
    "nodejs",
    "jwt",
    "auth",
    "postgresql"
  ],
