# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=myapp_dev

# JWT Configuration
JWT_SECRET=your_very_secret_and_long_jwt_key_generate_one

# CORS Configuration
CORS_ORIGIN=http://localhost:5173 # Example: For a Vite frontend, or your specific frontend URL

# Rate Limiting (Optional - Defaults are set in code if these are not present)
# RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
# RATE_LIMIT_MAX_REQUESTS=100
# LOGIN_RATE_LIMIT_WINDOW_MS=3600000 # 1 hour
# LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
